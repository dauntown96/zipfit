{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__Gmail",
      "mcp__Slack",
      "mcp__Canva",
      "mcp__bbb71e44-2993-4e98-a215-4b1ea5be27c5",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Slack",
      "mcp__claude_ai_Canva"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-setup.sh\"",
            "timeout": 150
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-check.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
