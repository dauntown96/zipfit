#!/usr/bin/env bash
# git pre-push 훅 — push 전에 문서 검사(scripts/doc-check.sh · PR check 「문서 검사」와 같은 한 벌)를 돈다
#   (2026-11-19 · 우편함 「코드·운영 — 12장」 · 막는 길 (가) — 사람이 부르는 단계 0 · 세션 준비가 core.hooksPath 를 걸어 둔다).
# 🔴 막는 것은 문서 검사가 실패한 push 뿐이다. 훅 자체의 사정(기준점 없음 · python 없음 · 스크립트 없음)으로는 막지 않는다.
# 🔴 가지 지우기 push(로컬 sha 0)는 보지 않는다. 기준점 = origin/main 과의 merge-base(못 찾으면 Liquid 만 건너뛴다).
# 급할 때 한 번 건너뛰기: git push --no-verify (회신에 적는다).
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$root/scripts/doc-check.sh" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
zero=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  # 문서 검사는 작업 트리를 본다 — 밀려는 커밋이 지금 HEAD 일 때만(세션의 보통 꼴). 다른 커밋이면 건너뛴다.
  [ "$local_sha" = "$(git -C "$root" rev-parse HEAD 2>/dev/null)" ] || continue
  base=$(git -C "$root" merge-base origin/main "$local_sha" 2>/dev/null || true)
  if ! BASE_SHA="$base" timeout 20 bash "$root/scripts/doc-check.sh" "$local_sha"; then
    st=$?
    [ "$st" = 124 ] && { echo "pre-push 문서 검사: 20초 넘음 — 막지 않고 넘긴다(PR check 가 다시 본다)"; continue; }
    echo "pre-push 문서 검사 실패 — 위 줄을 고친 뒤 다시 push(PR check 「문서 검사」와 같은 검사)"
    rc=1
  fi
done
exit "$rc"
